# =============================================================================
# crypto_bot — environment configuration.
# Copy to ".env" and fill in. ".env" is gitignored; never commit real secrets.
# =============================================================================

# --- Runtime mode ------------------------------------------------------------
# signal_only : compute & log signals only (no order simulation) [default]
# paper       : simulate orders against market data (no real money)
# live        : place REAL orders (gated; see ENABLE_LIVE_TRADING below)
CRYPTO_BOT_MODE=signal_only

# --- Master kill switch ------------------------------------------------------
# If false, the bot will refuse to run the trading loop / place orders.
ENABLE_TRADING=false

# --- Live trading gate -------------------------------------------------------
# Even with CRYPTO_BOT_MODE=live, REAL orders are placed ONLY if this is true.
# Leave false until paper trading + tests are green. Implemented in a later stage.
ENABLE_LIVE_TRADING=false

# --- Exchange (ccxt) ---------------------------------------------------------
# Name must match a ccxt exchange id. Binance by default.
EXCHANGE_NAME=bybit
EXCHANGE_API_KEY=u8bz6mtbvlb626VLea
EXCHANGE_API_SECRET=38D0bHS0HijBaFT0FRBLc31ztoSR28EDLClV
# Use testnet / sandbox endpoints. Recommended for paper & first live tests.
EXCHANGE_SANDBOX=true

# --- Storage -----------------------------------------------------------------
DB_PATH=data/crypto_bot.db

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/crypto_bot.log
# Emit structured JSON log records (false = human-readable plaintext).
LOG_JSON=false

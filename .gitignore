# --- Secrets & local config ---
.env
.env.*
!.env.example
# config/settings.yaml НЕ игнорируется: это операционный конфиг, которым
# получены все исследовательские числа. Пока он лежал вне version control,
# "Config Snapshot" в pre-registration был единственной его записью, и сверить
# их было нечем — расхождение по шести полям копилось незамеченным. Секретов в
# нём нет: ключи биржи живут в .env (config/env.py), он игнорируется выше.
config/universe.yaml

# --- Runtime data & logs ---
data/*
!data/.gitkeep
# Снимки спецификаций фиксируют вселенную бэктеста по sha256 (поправка 2 Task 0'
# funding/basis): они версионируются, в отличие от 24-часового кэша рядом.
!data/instruments/
data/instruments/*
!data/instruments/bybit_instruments_*.json
!data/cache/
data/cache/*
!data/cache/bybit_instruments_2026-09-26T0709Z.json
logs/*
!logs/.gitkeep
*.db
*.db-journal
*.sqlite
*.sqlite3

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# --- Virtualenvs ---
.venv/
venv/
env/

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.claude/hooks/.mypy_pending

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
